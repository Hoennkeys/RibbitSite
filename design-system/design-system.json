          "type": "function",
          "description": "Callback executed when main button is clicked"
        }
      ],
      "structure": "<section className=\"hero-section\">\n  <div className=\"hero-content\">\n    <h1 className=\"hero-title\">{title}</h1>\n    <p className=\"hero-subtitle\">{subtitle}</p>\n    <div className=\"hero-ctas\">\n      <button className=\"btn-primary\" onClick={onCtaClick}>Baixar Grátis</button>\n      <button className=\"btn-secondary\">Conhecer Projeto</button>\n    </div>\n  </div>\n  <div className=\"hero-mockup\">\n    <div className=\"glow-bg-primary\"></div>\n    <div className=\"phone-mockup-wrapper\">\n      {/* 3D phone screen inside phone casing */}\n    </div>\n  </div>\n</section>",
      "tokens_used": [
