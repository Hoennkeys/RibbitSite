      "structure": "<div className={`feature-card size-${size}`}>\n  <div className=\"icon-wrapper\">{icon}</div>\n  <h3 className=\"card-title\">{title}</h3>\n  <p className=\"card-desc\">{description}</p>\n</div>",
      "tokens_used": [
        "colors.surface",
        "colors.border",
        "borderRadius.scale.lg",
        "spacing.scale.md",
        "typography.sizes.lg"
      ],
      "classes_used": [
        "card-glass"
      ]
    },
    {
      "name": "CTAButton",
      "description": "Highly interactive button supporting neon gradients, icons, and micro-animations.",
      "props": [
        {
          "name": "label",
          "type": "string",
          "description": "The button display text"
        },
        {
          "name": "variant",
          "type": "string",
          "description": "'primary' (green neon) or 'secondary' (blue/border)"
        },
        {
          "name": "icon",
          "type": "string",
          "description": "Optional trailing icon emoji or SVG"
        },
        {
          "name": "onClick",
          "type": "function",
          "description": "Execution callback"
        }
      ],
      "structure": "<button className={`cta-btn variant-${variant}`} onClick={onClick}>\n  <span className=\"btn-label\">{label}</span>\n  {icon && <span className=\"btn-icon\">{icon}</span>}\n</button>",
      "tokens_used": [
        "colors.primary",
        "colors.accent",
        "borderRadius.scale.md",
        "shadows.scale.neon_primary"
      ],
      "classes_used": [
        "btn-neon-primary",
        "btn-neon-accent"
      ]
    },
    {
      "name": "ScreensCarousel",
      "description": "Interactive layout showcasing app screens (Dashboard, SoundID, Wizard) in a sliding viewport.",
      "props": [
        {
          "name": "screens",
          "type": "array",
          "description": "List of screen objects containing title, description, and mock image URL"
        }
      ],
      "structure": "<div className=\"carousel-container\">\n  <div className=\"carousel-viewport\">\n    {screens.map((screen, idx) => (\n      <div key={idx} className=\"carousel-slide\">\n        <div className=\"slide-mockup-wrapper\">\n          <img src={screen.imageUrl} alt={screen.title} className=\"slide-image\" />\n        </div>\n        <div className=\"slide-info\">\n          <h4 className=\"slide-title\">{screen.title}</h4>\n          <p className=\"slide-desc\">{screen.description}</p>\n        </div>\n      </div>\n    ))}\n  </div>\n  <div className=\"carousel-indicators\">\n    {screens.map((_, idx) => (\n      <span key={idx} className=\"dot\" />\n    ))}\n  </div>\n</div>",
      "tokens_used": [
        "colors.background",
        "borderRadius.scale.xl",
        "spacing.scale.xl",
        "shadows.scale.medium"
      ],
      "classes_used": [
